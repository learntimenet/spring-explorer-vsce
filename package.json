{
  "name": "spring-explorer",
  "displayName": "Spring Explorer",
  "description": "Explore Spring beans in a dedicated editor panel: dependency levels, injection hierarchy, and REST endpoints",
  "publisher": "learntime",
  "version": "1.0.0",
  "icon": "icon.png",
  "keywords": [
    "spring",
    "spring boot",
    "beans",
    "dependency injection",
    "rest endpoints",
    "java",
    "explorer",
    "vscode"
  ],
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/learntimenet/spring-explorer-vsce.git"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "tsc -p ./ && vsce package",
    "publish": "tsc -p ./ && vsce publish"
  },
  "contributes": {
    "commands": [
      {
        "command": "springExplorer.open",
        "title": "Spring Explorer: Open"
      },
      {
        "command": "springExplorer.reveal",
        "title": "Spring Explorer: Reveal Bean"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "springExplorer.reveal",
          "when": "editorLangId == java"
        }
      ],
      "editor/context": [
        {
          "command": "springExplorer.reveal",
          "when": "editorLangId == java",
          "group": "navigation@90"
        }
      ],
      "explorer/context": [
        {
          "command": "springExplorer.reveal",
          "when": "resourceExtname == .java",
          "group": "navigation@90"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.105.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "vscode": "^1.105.0"
  }
}
